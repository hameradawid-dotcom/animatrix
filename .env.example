# Skopiuj do .env i uzupełnij. Plik .env NIGDY nie trafia do gita.

# --- Anthropic (generator scenariusza / storyboardu / kodu scen) ---
ANTHROPIC_API_KEY=sk-ant-...
# Model używany do wszystkich wywołań. claude-opus-5 = najlepsza jakość kodu scen.
# Tańsza alternatywa: claude-sonnet-5
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high

# --- ElevenLabs (lektor) ---
# Wystarczy ta jedna zmienna. Narzędzie samo eksportuje ją do podprocesu Manima
# jako ELEVEN_API_KEY, bo pod taką nazwą szuka jej manim-voiceover.
ELEVENLABS_API_KEY=
# ID głosu z panelu ElevenLabs (Voice Library -> ID)
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 czyta polski poprawnie; eleven_turbo_v2_5 jest tańszy/szybszy
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Silnik mowy ---
# elevenlabs = prawdziwy lektor (kosztuje znaki)
# silent     = cisza o oszacowanej długości; ZERO kosztów, do testów kodu i podglądów
EXPLAINER_TTS=elevenlabs

# Tempo mowy przy szacowaniu długości ciszy (znaki na sekundę) dla trybu silent
EXPLAINER_SILENT_CPS=14.5

# --- Ścieżki ---
# Katalog z projektami (domyślnie ./projects)
EXPLAINER_PROJECTS_DIR=projects
